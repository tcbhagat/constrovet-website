{
  "name": "constrovet-website",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project=desktop-chromium",
    "test:all": "npm test && npm run check && npm run test:harness && npm run test:e2e",
    "test:harness": "node scripts/run-eev2-harness.mjs",
    "check:golden": "node scripts/check-golden-sample.mjs",
    "check:fixtures": "node scripts/check-fixture-provenance.mjs",
    "check": "exit 0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
