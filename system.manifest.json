{
  "schema_version": "1.0.0",
  "updated": "2026-09-01",
  "purpose": "Single source of truth for the Constrovet system. Routes, services, denylists and known gaps are declared here and nowhere else. scripts/verify.mjs checks reality against this file. If a fact in a document contradicts this file, the document is wrong.",

  "identity": {
    "name": "Constrovet",
    "domain": "www.constrovet.com",
    "scope": "Construction cost, delay, ESG and financier-risk evidence review in India",
