    { "path": "/claim-companion/",                                  "file": "claim-companion/index.html",                        "family": "preserved-unlinked", "topic": "claim-companion", "index": false, "sitemap": false, "smoke": false },
    { "path": "/ssm-core-demo/",                                    "file": "ssm-core-demo/index.html",                          "family": "preserved-unlinked", "topic": "ssm-core",    "index": false, "sitemap": false, "smoke": false }
  ],

  "discovery_surfaces": [
    "index.html",
    "assets/nav.html",
    "assets/footer.html",
    "pages/contact.html",
    "sitemap.xml",
    "llms.txt"
  ],

  "denylist": {
    "reason": "Rule H4. These products are preserved but must never appear in construction discovery surfaces.",
    "terms": [
      "claim-companion",
      "Claim Companion",
      "Hospital Cost Estimate",
      "ChallanSe",
      "ssm-core-demo",
      "CA Beta",
      "CA statutory cockpit"
    ]
  },

  "retired_infrastructure": {
    "reason": "Rule H3. These must not appear on public entry pages.",
    "patterns": ["app\\.constrovet\\.com", "prod-constrovet", "run\\.app"],
    "checked_files": ["index.html", "demo.html", "app/index.html", "boardroom/index.html"]
  },

  "public_safety": {
    "reason": "Rule H2. This repository is public.",
    "forbidden_patterns_in_docs": ["/home/[a-z]", "AKfy[A-Za-z0-9_-]{30,}", "AIza[0-9A-Za-z_-]{20,}"],
    "note": "Policy text naming these categories is fine. Actual values and real local paths are not."
  },

  "services": [
    { "name": "GitHub Pages static site",        "status": "active",         "note": "Main public production path." },
    { "name": "Browser Analyse (/app/)",         "status": "active",         "note": "No upload required. No cost. Explain limits plainly." },
    { "name": "Boardroom intake (/boardroom/)",  "status": "active",         "note": "Routes qualified requests into the Workspace path." },
    { "name": "Workspace Apps Script / Drive / MailApp", "status": "active", "note": "Free-tier processor. Role-owned storage only." },
    { "name": "Public SEO files",                "status": "active",         "note": "sitemap, robots and llms.txt must match manifest routes." },
    { "name": "Gemini evidence review",          "status": "approval-gated", "note": "Only after explicit user action. Deterministic citations stay authoritative." },
    { "name": "EEV2 production deployment",      "status": "approval-gated", "note": "Rule H6. Locally stable, not production-approved." },
    { "name": "Branded app subdomains, public APIs", "status": "approval-gated", "note": "Do not activate from documentation alone." },
    { "name": "Claim Companion / ChallanSe / SSM Core routes", "status": "preserved-unlinked", "note": "Source retained. noindex. Never linked from construction surfaces." },
    { "name": "Cloud Run, GCP paid backend, GCS, Cloud SQL, Firestore, paid monitoring", "status": "retired", "note": "Rule H3. Rollback reference only." },
    { "name": "Public tunnels, hosted autonomous agents", "status": "retired", "note": "Rule H3." }
  ],

  "known_gaps": [
    {
      "id": "GAP-001",
      "title": "Duplicate service pages compete for the same keywords",
      "detail": "Five topics each have a root-level clean URL and a /pages/*.html twin. Both are indexed and self-canonicalise. This splits ranking signal and creates ambiguity about which file to edit.",
      "intent": "Root clean URLs are primary. Each /pages/ twin gets noindex plus a canonical pointing at its primary, or is merged and removed from the sitemap.",
      "severity": "high",
      "opened": "2026-09-01",
      "closes_when": "verify.mjs topic check passes with no pending entries"
    },
    {
      "id": "GAP-002",
      "title": "LOCAL_CONTENT_REFRESH_ROLLBACK.md contains a real local machine path",
      "detail": "The file publishes an operator home directory and a stale local branch name in a public repository. It breaks Rule H2 and describes work that is finished.",
      "intent": "Delete the file. Record the rollback approach as a DECISIONS entry instead.",
      "severity": "medium",
      "opened": "2026-09-01",
      "closes_when": "file removed and public_safety check passes"
    },
    {
      "id": "GAP-003",
      "title": "README project structure is stale",
      "detail": "The tree in README lists nine pages and omits blog, boardroom, tests, scripts, docs, android and the preserved products. An agent orienting from it forms a wrong model of the repo.",
      "intent": "README stops describing structure. The manifest owns route truth.",
      "severity": "medium",
      "opened": "2026-09-01",
      "closes_when": "README rewritten to point at AGENTS.md and the manifest"
    },
    {
      "id": "GAP-004",
      "title": "CI path filters leave gaps",
      "detail": "Workflows only fire on listed paths. Edits to blog, docs, or root-level service pages run no gate at all.",
      "intent": "Add a site-wide verify job that runs on every pull request with no path filter.",
      "severity": "medium",
      "opened": "2026-09-01",
      "closes_when": "verify workflow runs unconditionally on pull_request"
    },
    {
      "id": "GAP-006",
      "title": "EDITING.md publishes a real local machine path",
      "detail": "Found by the first verify.mjs run. The Local Ubuntu Workflow section names an operator home directory in a public repository. Breaks Rule H2.",
      "intent": "EDITING.md merges into README. The local workflow uses a placeholder path.",
      "severity": "high",
      "opened": "2026-09-01",
      "closes_when": "public_safety check reports zero failures"
    },
    {
      "id": "GAP-005",
      "title": "Seven overlapping SEO documents in docs/",
      "detail": "seo-geo-audit, seo-geo-change-log, final-seo-geo-validation, geo-optimisation, SEO_LAUNCH_CHECKLIST, search-console-setup and content-calendar restate each other. Loading them costs context and produces contradictions.",
      "intent": "Collapse to one policy document plus one append-only log. Move the rest to docs/archive/.",
      "severity": "low",
      "opened": "2026-09-01",
      "closes_when": "docs/ contains a single active SEO policy file"
    }
  ]
}
