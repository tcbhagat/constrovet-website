    { "path": "/pages/solution.html",                               "file": "pages/solution.html",                               "family": "construction", "topic": "solution",          "index": true,  "sitemap": true,  "smoke": false },
    { "path": "/pages/how-it-works.html",                           "file": "pages/how-it-works.html",                           "family": "construction", "topic": "how-it-works",      "index": true,  "sitemap": true,  "smoke": false },
    { "path": "/pages/industries.html",                             "file": "pages/industries.html",                             "family": "construction", "topic": "industries",        "index": true,  "sitemap": true,  "smoke": false },
