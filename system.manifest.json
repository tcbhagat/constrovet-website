    { "path": "/pages/construction-cost-overrun-analysis.html",     "file": "pages/construction-cost-overrun-analysis.html",     "family": "construction", "topic": "cost-leakage-overrun", "index": false, "sitemap": false, "smoke": false, "consolidate_into": "/construction-cost-leakage-audit", "gap": "GAP-001" },
    { "path": "/pages/construction-esg-carbon-audit.html",          "file": "pages/construction-esg-carbon-audit.html",          "family": "construction", "topic": "esg-carbon",        "index": false, "sitemap": false, "smoke": false, "consolidate_into": "/construction-esg-carbon-audit", "gap": "GAP-001" },
    { "path": "/pages/construction-due-diligence-financiers.html",  "file": "pages/construction-due-diligence-financiers.html",  "family": "construction", "topic": "financier-diligence", "index": false, "sitemap": false, "smoke": false, "consolidate_into": "/construction-financier-risk-audit", "gap": "GAP-001" },
